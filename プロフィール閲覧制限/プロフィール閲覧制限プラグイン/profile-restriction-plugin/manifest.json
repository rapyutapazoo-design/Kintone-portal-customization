{
  "manifest_version": 1,
  "version": 1,
  "type": "APP",
  "name": {
    "ja": "プロフィール閲覧制限プラグイン",
    "en": "Profile View Restriction Plugin"
  },
  "description": {
    "ja": "許可された組織・グループに所属していないユーザーが他のユーザーのプロフィール詳細を閲覧できないようにします。",
    "en": "Restricts profile detail viewing to users in permitted organizations or groups."
  },
  "icon": "image/icon.png",
  "desktop": {
    "js": ["js/common.js", "js/desktop.js"],
    "css": ["css/desktop.css"]
  },
  "mobile": {
    "js": ["js/common.js", "js/mobile.js"],
    "css": ["css/mobile.css"]
  },
  "config": {
    "html": "html/config.html",
    "js": ["js/config.js"],
    "css": ["css/config.css"],
    "required_params": []
  }
}
